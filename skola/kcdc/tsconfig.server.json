{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [
      "@kingdomsconnected/types/server"
    ],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "src/server.ts",
    "src/data.ts",
    "src/nastaveni.ts",
    "src/shared/*.ts",
    "src/opravneni.ts",
    "src/lang/*.ts"
  ]
}
